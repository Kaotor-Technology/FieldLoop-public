{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/config/**",
    "DESIGN.md"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@fieldloop/contracts#typecheck": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@fieldloop/adapters#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/domain-packs/**"],
      "outputs": []
    },
    "@fieldloop/api#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/domain-packs/**", "$TURBO_ROOT$/data/synthetic/dl-01/bowtie-a.json", "$TURBO_ROOT$/data/synthetic/bangkok/bowtie-d.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
