# Restricted browser key supplied to the authenticated BFF map configuration endpoint.
# Do not commit a real key. Create it through infra/terraform and keep its referrer/API restrictions.
FIELDLOOP_MAPS_API_KEY=

# Simulator configuration (apps/simulator/docs/mock-sources.md)
FIELDLOOP_ENV=local
FIELDLOOP_ORG_ID=fieldloop-demo

# Optional: set to a Google Cloud project to enable Pub/Sub signal publishing.
GOOGLE_CLOUD_PROJECT=
