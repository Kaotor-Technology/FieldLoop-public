{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationContract",
  "$defs": {
    "SimulationRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "scenarioName": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "clock": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "playing",
            "paused",
            "finished"
          ]
        },
        "nextEventIndex": {
          "type": "integer",
          "minimum": 0
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "simulated": {
          "const": true
        },
        "classification": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "HIGHLY_RESTRICTED"
          ]
        },
        "bookmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "atSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "atSeconds"
            ]
          }
        }
      },
      "required": [
        "id",
        "orgId",
        "scenarioId",
        "scenarioName",
        "seed",
        "speed",
        "clock",
        "elapsedSeconds",
        "durationSeconds",
        "state",
        "nextEventIndex",
        "eventCount",
        "simulated",
        "classification",
        "bookmarks"
      ]
    },
    "RunCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "scenarioId",
        "seed",
        "speed"
      ]
    },
    "PlayerCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "bookmarkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": []
    },
    "ScenarioSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "durationSeconds": {
          "type": "number"
        },
        "simulated": {
          "const": true
        },
        "classification": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "HIGHLY_RESTRICTED"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "durationSeconds",
        "simulated",
        "classification"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/SimulationRun"
    },
    {
      "$ref": "#/$defs/RunCreate"
    },
    {
      "$ref": "#/$defs/PlayerCommand"
    },
    {
      "$ref": "#/$defs/ScenarioSummary"
    }
  ]
}
