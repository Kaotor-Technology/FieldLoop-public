{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "scenario.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 2678400
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "HIGHLY_RESTRICTED"
      ]
    },
    "simulated": {
      "const": true
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "atSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 2678400
          },
          "source": {
            "type": "string",
            "enum": [
              "mock-historian",
              "mock-cmms",
              "mock-patrol",
              "mock-ili",
              "mock-hydro",
              "mock-pumps"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "asset",
                  "barrier",
                  "source"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 64
          },
          "noiseAmplitude": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "atSeconds",
          "source",
          "target",
          "tag",
          "value"
        ]
      }
    },
    "bookmarks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "atSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "atSeconds"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "startsAt",
    "durationSeconds",
    "classification",
    "simulated",
    "events",
    "bookmarks"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario"
}
