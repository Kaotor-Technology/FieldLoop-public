{
  "name": "fieldloop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "10.34.6"
  },
  "pnpm": {
    "overrides": {
      "@luma.gl/shadertools": "9.3.6"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts db/seed data/synthetic/bangkok data/synthetic/corpus/generate.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test && vitest run --config vitest.config.ts",
    "lint:design": "design.md lint DESIGN.md",
    "lint:api": "pnpm --filter @fieldloop/contracts lint:openapi",
    "check:safety": "node scripts/check-confidential-paths.mjs",
    "check:ai-boundary": "node scripts/check-ai-boundary.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "db:seed:dl-01": "node db/seed/dl-01/seed.mjs",
    "db:seed:bangkok": "node db/seed/bangkok/seed.mjs",
    "generate:geo-reference": "uv run --locked scripts/generate-geo-reference.py",
    "db:migrate": "dbmate --migrations-table public.schema_migrations up",
    "test:migrations": "bash scripts/test-migrations.sh",
    "test:audit-api": "bash scripts/test-audit-api.sh",
    "test:risk-service": "bash scripts/test-risk-service.sh",
    "test:guardrail-store": "bash scripts/test-guardrail-store.sh",
    "test:seed": "bash scripts/test-seed.sh",
    "test:seed:legal": "node scripts/test-legal-seed.mjs",
    "test:seed:bangkok": "bash scripts/test-bangkok-seed.sh",
    "test:audit-writer": "node scripts/test-audit-runner-safety.mjs && pnpm exec turbo run build --filter=@fieldloop/adapters... && node scripts/test-audit-writer.mjs",
    "test:signals": "pnpm exec turbo run build --filter=@fieldloop/signal-worker... --filter=@fieldloop/api... && node scripts/test-signal-worker.mjs",
    "test:domain-packs": "pnpm exec turbo run build --filter=@fieldloop/api... --filter=@fieldloop/guardrail... && bash scripts/test-domain-packs.sh",
    "test:actions": "bash scripts/test-actions.sh"
  },
  "devDependencies": {
    "@fieldloop/config": "workspace:*",
    "@google/design.md": "0.4.0",
    "@types/node": "22.20.5",
    "dbmate": "2.28.0",
    "eslint": "10.12.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
