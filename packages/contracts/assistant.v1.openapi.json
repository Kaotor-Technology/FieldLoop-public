{
  "openapi": "3.1.0",
  "info": {
    "title": "FieldLoop assistant internal service — session lifecycle slices",
    "version": "0.0.0",
    "description": "Internal service contract, not a browser API. Session creation, SSE messages and cooperative cancellation are documented. Runtime/spec parity remains separately verified.",
    "contact": {
      "name": "FieldLoop engineering",
      "url": "https://github.com/Kaotor-Technology/FieldLoop-v2"
    }
  },
  "paths": {
    "/assistant/v1/sessions": {
      "post": {
        "operationId": "createAssistantSession",
        "summary": "Create an assistant session",
        "description": "Requires a verified internal user token. Only startable coordinators are accepted; identity and classification come from the verified token, not request fields. No approval or consequential action is performed.",
        "security": [
          {
            "internalUserToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "example": {
                "agent": "flood-situation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session bound to the authenticated internal user. Example is SYNTHETIC.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "agent",
                    "simulated",
                    "classification",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "agent": {
                      "type": "string"
                    },
                    "simulated": {
                      "type": "boolean"
                    },
                    "classification": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "id": "synthetic-session",
                  "agent": "flood-situation",
                  "simulated": true,
                  "classification": "INTERNAL",
                  "status": "active"
                }
              }
            }
          },
          "400": {
            "description": "agent_not_startable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "agent_not_startable",
                  "status": 400,
                  "code": "agent_not_startable"
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "unauthenticated",
                  "status": 401,
                  "code": "unauthenticated"
                }
              }
            }
          },
          "422": {
            "description": "FastAPI request validation failure (not the shared Problem format).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "loc",
                          "msg",
                          "type"
                        ],
                        "properties": {
                          "loc": {
                            "type": "array",
                            "items": {
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "integer"
                                }
                              ]
                            }
                          },
                          "msg": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "service_unavailable",
                  "status": 503,
                  "code": "service_unavailable"
                }
              }
            }
          }
        },
        "tags": [
          "Assistant"
        ]
      }
    },
    "/assistant/v1/sessions/{session_id}:cancel": {
      "post": {
        "operationId": "cancelAssistantSession",
        "summary": "Request assistant turn cancellation",
        "description": "Looks up the session for the authenticated organization and user. Requests cooperative cancellation only; no approval or consequential action is executed.",
        "tags": [
          "Assistant"
        ],
        "security": [
          {
            "internalUserToken": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested. A false value means no active turn was cancelled; this response does not assert completed cancellation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cancelling"
                  ],
                  "properties": {
                    "cancelling": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "cancelling": true
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "unauthenticated",
                  "status": 401,
                  "code": "unauthenticated"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/problem+json": {
                "schema": {
