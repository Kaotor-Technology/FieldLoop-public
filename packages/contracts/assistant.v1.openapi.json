                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "not_found",
                  "status": 404,
                  "code": "not_found"
                }
              }
            }
          },
          "422": {
            "description": "FastAPI request validation failure (not the shared Problem format).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "loc",
                          "msg",
                          "type"
                        ],
                        "properties": {
                          "loc": {
                            "type": "array",
                            "items": {
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "integer"
                                }
                              ]
                            }
                          },
                          "msg": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "service_unavailable",
                  "status": 503,
                  "code": "service_unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/assistant/v1/sessions/{session_id}/messages": {
      "post": {
        "operationId": "sendAssistantMessage",
        "summary": "Stream an assistant turn",
        "description": "Requires signed internal user identity and a session owned by that user and organization, within clearance. Concurrent turns return 409 before streaming. Runtime events are SSE, not a JSON response; no approval or consequential action is performed by this endpoint. Events contain JSON data and monotonic per-turn IDs; errors after headers use answer.error, not a second HTTP status. Current runtime uses non-partial model output: answer.partial is reserved and is not emitted. The example is synthetic, not a live answer or approval. Optional structured model fields are not advertised as runtime-validated metrics.",
        "tags": [
          "Assistant"
        ],
        "security": [
          {
            "internalUserToken": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              },
              "example": {
                "message": "Summarize the SYNTHETIC flood scenario."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of assistant runtime events; successful transport does not imply completed work or approval. Tool-call decisions carry the registered Policy ID when available; other decision sources may provide their own identifier.",
            "headers": {
              "Cache-Control": {
                "description": "Do not cache user-scoped output.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "X-Accel-Buffering": {
                "description": "Disable proxy response buffering.",
                "schema": {
                  "type": "string",
                  "const": "no"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "syntheticGuardedRead": {
                    "summary": "SYNTHETIC bounded read; Guardrail decision precedes tool result and final answer",
                    "value": "id: 1\nevent: agent.step\ndata: {\"agent\":\"integrity-orchestrator\",\"phase\":\"start\",\"step\":1}\n\nid: 2\nevent: tool.call\ndata: {\"agent\":\"integrity-orchestrator\",\"tool\":\"get_barriers\",\"args_hash\":\"synthetic-argument-hash\",\"step\":2}\n\nid: 3\nevent: guardrail.decision\ndata: {\"agent\":\"integrity-orchestrator\",\"tool\":\"get_barriers\",\"decision\":\"allow\",\"reason\":null,\"ceiling\":null,\"policy_id\":\"22222222-2222-4333-8444-555555555555\",\"action_request_id\":null,\"held_request_id\":null,\"source\":\"guardrail\"}\n\nid: 4\nevent: tool.result\ndata: {\"agent\":\"integrity-orchestrator\",\"tool\":\"get_barriers\",\"summary\":\"Synthetic empty barrier list\",\"step\":3}\n\nid: 5\nevent: answer.final\ndata: {\"answer\":\"Synthetic example: no barriers in this fixture.\",\"citations\":[],\"known\":[],\"unknown\":[],\"assumptions\":[],\"confidence\":\"low\",\"confidence_reason\":\"Synthetic documentation fixture\",\"retrieved_citations\":[],\"draft_ids\":[],\"action_request_ids\":[],\"held_request_ids\":[]}\n\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "unauthenticated",
                  "status": 401,
                  "code": "unauthenticated"
                }
              }
            }
          },
          "403": {
            "description": "forbidden (before streaming begins).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "forbidden",
                  "status": 403,
                  "code": "forbidden"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "not_found",
                  "status": 404,
                  "code": "not_found"
                }
              }
            }
          },
          "409": {
            "description": "turn_in_progress (before streaming begins).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
