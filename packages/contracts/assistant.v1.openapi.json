          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "type": "about:blank",
                  "title": "service_unavailable",
                  "status": 503,
                  "code": "service_unavailable"
                }
              }
            }
          }
        },
        "x-fieldloop-sse-events": {
          "agent.step": {
            "type": "object",
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "step": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "tool.call": {
            "type": "object",
            "required": [
              "agent",
              "tool",
              "args_hash",
              "step"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "args_hash": {
                "type": "string"
              },
              "step": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "guardrail.decision": {
            "type": "object",
            "required": [
              "agent",
              "tool",
              "decision",
              "source",
              "policy_id"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "allow",
                  "convert_l1",
                  "hold_l2",
                  "block"
                ]
              },
              "source": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ceiling": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action_request_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "held_request_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Policy identifier associated with this decision. Tool-call decisions use the registered Guardrail Policy ID; null means the source did not provide an ID."
              }
            }
          },
          "tool.result": {
            "type": "object",
            "required": [
              "agent",
              "tool",
              "summary",
              "step"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "step": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "answer.final": {
            "type": "object",
            "required": [
              "answer",
              "citations",
              "retrieved_citations",
              "draft_ids",
              "action_request_ids",
              "held_request_ids"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "retrieved_citations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "draft_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "action_request_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "held_request_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "answer.incomplete": {
            "type": "object",
            "required": [
              "answer",
              "incomplete"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "incomplete": {
                "type": "string"
              }
            }
          },
          "answer.error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalUserToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-fieldloop-internal-user-token",
        "description": "Existing service-to-service signed user identity; never a browser bearer token."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Internal service origin; not the browser BFF."
    }
  ],
  "tags": [
    {
      "name": "Assistant",
      "description": "Internal assistant session lifecycle."
    }
  ]
}
