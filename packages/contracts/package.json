{
  "name": "@fieldloop/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm generate && pnpm build:reference && tsc -p tsconfig.build.json",
    "build:reference": "node scripts/reference.mjs",
    "lint": "eslint .",
    "lint:openapi": "spectral lint openapi.yaml --ruleset .spectral.yaml --fail-severity warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.yaml -o src/generated/api.ts"
  },
  "devDependencies": {
    "@fieldloop/config": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@stoplight/spectral-cli": "6.16.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
