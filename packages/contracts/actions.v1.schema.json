{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldloop.kaotor.com/schemas/actions.v1.json",
  "title": "ActionContract",
  "$defs": {
    "ActionLevel": {
      "type": "string",
      "enum": [
        "l0",
        "l1",
        "l2"
      ]
    },
    "ActionType": {
      "type": "string",
      "enum": [
        "internal_record",
        "system_of_record",
        "field_command",
        "engineering_approval",
        "emergency_communication",
        "external_submission"
      ]
    },
    "ActionClassification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "HIGHLY_RESTRICTED"
      ]
    },
    "CommandPackagePayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["target", "action", "procedure", "barrierId", "preconditions", "expectedEffect"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "action": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "procedure": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" },
        "barrierId": { "type": "string", "format": "uuid" },
        "expectedEffect": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "preconditions": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
        }
      }
    },
    "ActionTarget": {
      "type": "string",
      "enum": [
        "fieldloop",
        "cmms",
        "integrity-database",
        "gis",
        "asset-register",
        "siem",
        "historian",
        "scada",
        "ot",
        "engineering-authority",
        "stakeholders",
        "regulator",
        "external-party"
      ]
    },
    "ActionRequestCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionType",
        "actionLevel",
        "target",
        "payload",
        "rationale",
        "citations",
        "simulated",
        "classification"
      ],
      "properties": {
        "actionType": {
          "$ref": "#/$defs/ActionType"
        },
        "actionLevel": {
          "$ref": "#/$defs/ActionLevel"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "simulated": {
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/ActionClassification"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "simulationRunId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [{
        "if": { "properties": { "actionType": { "const": "field_command" } }, "required": ["actionType"] },
        "then": { "properties": { "actionLevel": { "const": "l1" }, "target": { "enum": ["scada", "ot"] }, "payload": { "$ref": "#/$defs/CommandPackagePayload" } } }
      }]
    },
    "ToolCallCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aiSystem",
        "tool",
        "target",
        "simulated",
        "classification"
      ],
      "properties": {
        "actionType": {
          "$ref": "#/$defs/ActionType"
        },
        "actionLevel": {
          "$ref": "#/$defs/ActionLevel"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "simulated": {
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/ActionClassification"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "simulationRunId": {
          "type": "string",
          "format": "uuid"
        },
        "aiSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [{
        "if": { "properties": { "actionType": { "const": "field_command" } }, "required": ["actionType"] },
        "then": {
          "required": ["actionLevel", "payload", "rationale", "citations"],
          "properties": {
            "actionLevel": { "const": "l1" },
            "target": { "enum": ["scada", "ot"] },
            "payload": { "$ref": "#/$defs/CommandPackagePayload" },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
            "citations": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" } }
          }
        }
      }]
    },
    "ActionRequester": {
      "description": "Who requested the action (PRD AX-1). An assistant acts on behalf of requestedBy.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "aiSystemId"
          ],
          "properties": {
            "kind": {
              "const": "assistant"
            },
            "aiSystemId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "ActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "orgId",
        "actionType",
        "actionLevel",
        "target",
        "payload",
        "payloadHash",
        "rationale",
        "citations",
        "requestedBy",
        "requester",
        "status",
        "expiresAt",
        "simulated",
        "classification"
      ],
      "properties": {
        "actionType": {
          "$ref": "#/$defs/ActionType"
        },
        "actionLevel": {
          "$ref": "#/$defs/ActionLevel"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "simulated": {
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/ActionClassification"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "simulationRunId": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "requester": {
          "$ref": "#/$defs/ActionRequester"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "in_review",
            "awaiting_second",
            "approved",
            "rejected",
            "superseded",
            "executed"
          ]
        }
      }
    },
    "ToolCallDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "convert_l1",
            "hold_l2",
            "block"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "policyId": {
          "type": "string",
          "format": "uuid",
          "description": "Guardrail Policy applied to this tool-call decision."
        },
        "ceiling": {
          "$ref": "#/$defs/ActionLevel"
        },
        "actionRequest": {
          "$ref": "#/$defs/ActionRequest"
        },
        "heldRequestId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ActionDecisionCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadHash",
        "reason"
      ],
      "properties": {
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "ActionApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actionRequestId",
        "approverSub",
        "decision",
        "reason",
        "payloadHash",
        "authTime",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "actionRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "approverSub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authTime": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ActionDecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionRequest",
        "approval"
      ],
      "properties": {
        "actionRequest": {
          "$ref": "#/$defs/ActionRequest"
        },
        "approval": {
          "$ref": "#/$defs/ActionApproval"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ActionRequestCreate"
    },
    {
      "$ref": "#/$defs/ToolCallCheck"
    },
    {
      "$ref": "#/$defs/ActionRequest"
    },
    {
      "$ref": "#/$defs/ToolCallDecision"
    },
    {
      "$ref": "#/$defs/ActionDecisionCreate"
    },
    {
      "$ref": "#/$defs/ActionDecisionResult"
    }
  ]
}
