{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldloop.kaotor.com/schemas/domain-pack.v1.json",
  "title": "DomainPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "label", "simulated", "classification", "parameterBasis", "knowledgeFolders", "threatCategories", "signalRules", "agentFiles", "warningTemplates"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "label": { "enum": ["SIMULATION", "SYNTHETIC"] },
    "simulated": { "const": true },
    "classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "HIGHLY_RESTRICTED"] },
    "parameterBasis": { "type": "string", "minLength": 1 },
    "knowledgeFolders": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "agentFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^agents/[a-z][a-z0-9-]*\\.yaml$" } },
    "threatCategories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ThreatCategory" } },
    "signalRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SignalRule" } },
    "warningTemplates": { "type": "array", "items": { "$ref": "#/$defs/WarningTemplate" } }
  },
  "$defs": {
    "ThreatCategory": {
      "type": "object", "additionalProperties": false, "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "SignalRule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "condition", "targetBarrierSelector", "effect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "condition": { "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "source", "tag", "operator", "threshold", "unit"],
            "properties": {
              "kind": { "const": "signal" },
              "source": { "type": "string", "minLength": 1 },
              "tag": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["gt", "lt", "eq"] },
              "threshold": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "string", "minLength": 1 },
                  { "type": "boolean" }
                ]
              },
              "unit": { "type": "string", "minLength": 1 },
              "windowSeconds": { "type": "integer", "minimum": 1 }
            },
            "allOf": [{
              "if": { "properties": { "operator": { "enum": ["gt", "lt"] } }, "required": ["operator"] },
              "then": { "properties": { "threshold": { "type": "number" } } }
            }]
          },
          {
            "type": "object", "additionalProperties": false, "required": ["kind", "intervalSource"],
            "properties": { "kind": { "const": "evidence_ageing" }, "intervalSource": { "const": "barrier.evidence_interval" } }
          }
        ] },
        "targetBarrierSelector": {
          "type": "object", "additionalProperties": false, "required": ["pack", "bowtieCode", "barrierCodes"],
          "properties": {
            "pack": { "type": "string", "minLength": 1 },
            "bowtieCode": { "type": "string", "minLength": 1 },
            "barrierCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "effect": {
          "type": "object", "additionalProperties": false, "required": ["kind", "proposedHealth", "reason"],
          "properties": {
            "kind": { "const": "health_proposal" },
            "proposedHealth": { "enum": ["degraded", "failed", "unverified"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "spatialGeometry": {
          "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "type": "array", "minItems": 1, "items": {
              "type": "array", "minItems": 4, "items": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "items": false
              }
            } }
          }
        }
      }
    },
    "WarningTemplate": {
      "type": "object", "additionalProperties": false, "required": ["id", "actionLevel", "approvalRequired", "placeholders", "en", "th"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "actionLevel": { "const": "L2" },
        "approvalRequired": { "const": true },
        "placeholders": { "type": "array", "minItems": 1, "uniqueItems": true, "contains": { "const": "district" }, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" } },
        "en": { "type": "string", "minLength": 1, "pattern": "\\{\\{district\\}\\}" },
        "th": { "type": "string", "minLength": 1, "pattern": "\\{\\{district\\}\\}" }
      }
    }
  }
}
