{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisteredSignalRule",
  "type": "object", "additionalProperties": false,
  "required": ["id", "pack", "condition", "targetBarrierSelector", "simulated", "classification"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "pack": {"type": "string", "minLength": 1},
    "simulated": {"type": "boolean"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "HIGHLY_RESTRICTED"]},
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "tag", "operator", "threshold", "unit", "ruleId", "packVersion", "effect"],
      "not": {"properties": {"expectedIntervalSeconds": {}, "expectedIntervalMonths": {}}, "required": ["expectedIntervalSeconds", "expectedIntervalMonths"]},
      "properties": {
        "kind": {"const": "signal"}, "source": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}, "operator": {"enum": ["gt", "lt", "eq"]},
        "threshold": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}, {"type": "boolean"}]},
        "unit": {"type": "string", "minLength": 1},
        "ruleId": {"type": "string", "minLength": 1}, "packVersion": {"type": "string", "minLength": 1},
        "windowSeconds": {"type": "integer", "minimum": 1},
        "durationSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "expectedIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "expectedIntervalMonths": {"type": "integer", "minimum": 1, "maximum": 12},
        "effect": {
          "type": "object", "additionalProperties": false, "required": ["kind", "proposedHealth", "reason"],
          "properties": {
            "kind": {"const": "health_proposal"}, "proposedHealth": {"enum": ["degraded", "failed", "unverified"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"operator": {"enum": ["gt", "lt"]}}, "required": ["operator"]}, "then": {"properties": {"threshold": {"type": "number"}}}},
        {"if": {"properties": {"threshold": {"type": "string"}}, "required": ["threshold"]}, "then": {"properties": {"operator": {"const": "eq"}}}},
        {"if": {"properties": {"threshold": {"type": "boolean"}}, "required": ["threshold"]}, "then": {"properties": {"operator": {"const": "eq"}}}}
      ]
    },
    "targetBarrierSelector": {
      "type": "object", "additionalProperties": false, "required": ["pack", "bowtieCode", "barrierCodes"],
      "properties": {
        "pack": {"type": "string", "minLength": 1}, "bowtieCode": {"type": "string", "minLength": 1},
        "barrierCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
