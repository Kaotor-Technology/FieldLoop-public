{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldloop.kaotor.com/schemas/agent-definition.v1.json",
  "title": "AgentDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "useCase", "aiSystemId", "rolePrompt", "reasoningTemplate", "allowedTools", "delegates", "knowledgeFolders", "refusalRules", "modelTier", "maxSteps", "maxTokens"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "enum": ["coordinator", "specialist"] },
    "useCase": { "type": "string", "minLength": 1 },
    "aiSystemId": { "type": "string", "minLength": 1 },
    "rolePrompt": { "type": "string", "minLength": 1 },
    "reasoningTemplate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedTools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "delegates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "knowledgeFolders": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "refusalRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "modelTier": { "enum": [1, 2, 3] },
    "maxSteps": { "type": "integer", "minimum": 1, "maximum": 20 },
    "maxTokens": { "type": "integer", "minimum": 1, "maximum": 32000 }
  }
}
